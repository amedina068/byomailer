<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- The send jobs keep the `ses-sending` counters in Redis, as the production install does. The tests fake Redis. SesSendingLimiterTest covers the cache limiter of the Docker image. -->
        <env name="SES_SENDING_LIMITER" value="redis"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- `npm run build` writes bootstrap/ssr/ssr.js. With SSR on, each page test would call the SSR server, and the tests block that call. -->
        <env name="INERTIA_SSR_ENABLED" value="false" force="true"/>
        <env name="TRACKING_PROXY_IP" value="203.0.113.10"/>
        <env name="TRACKING_PROXY_ASK_TOKEN" value="test-ask-token"/>
        <!-- A test must never reach AWS. The AWS SDK sends each call to this closed local port, so a call that a test did not fake fails at once. -->
        <env name="AWS_ENDPOINT_URL" value="http://aws-calls-are-blocked-in-tests.localhost:1" force="true"/>
        <env name="AWS_IGNORE_CONFIGURED_ENDPOINT_URLS" value="false" force="true"/>
        <env name="AWS_MAX_ATTEMPTS" value="1" force="true"/>
        <env name="AWS_EC2_METADATA_DISABLED" value="true" force="true"/>
    </php>
</phpunit>
