# BYOMailer configuration.
# Copy this file to .env, then fill in the values for your install.
# The framework config files in config/ read more variables. This file lists
# the variables that a BYOMailer install uses.

#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------

APP_NAME=BYOMailer
# Keep production for a real install. Use local only for development on
# your own computer.
APP_ENV=production
# Generate with `php artisan key:generate`. The Docker image makes the key on
# the first start and keeps it in /data/.secrets/app_key.
# CAUTION: Back up APP_KEY. BYOMailer encrypts the AWS credentials of each
# account with it. If you lose the key, every account must enter its AWS
# credentials again.
APP_KEY=
# A file that holds the app key. The app reads it when APP_KEY is empty.
# APP_KEY_FILE=
# A comma-separated list of old keys. Use it when you rotate APP_KEY.
APP_PREVIOUS_KEYS=
# Keep false for a real install. Debug pages show settings and secrets.
APP_DEBUG=false
# The public URL of this install. Emails, API examples, and the MCP guide use it.
# If APP_URL is empty, the app uses https://APP_DOMAIN, or else
# http://localhost:8080.
# APP_URL=https://mail.example.com
# The domain of the install. In the Docker image, Caddy then gets a TLS
# certificate for it and serves the ports 80 and 443.
# APP_DOMAIN=mail.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# Accounts and access
#--------------------------------------------------------------------------

# When false, /register answers 404. The setup page (/setup) or
# `php artisan byomailer:install` creates the first user, the owner.
# Set it to true to let anyone sign up. This value is only the default:
# the mode that the owner sets in Admin, Settings overrides it.
REGISTRATION_ENABLED=false

# The number of REST API requests that one user can send in one minute.
API_RATE_LIMIT=300

# Only for the update of an install from before the owner account. The
# update makes the users in this comma-separated list owners. Only the owner
# can open Horizon (/horizon).
ADMIN_EMAILS=

#--------------------------------------------------------------------------
# Logs
#--------------------------------------------------------------------------

LOG_CHANNEL=stack
# Add `rollbar` to the list (for example `single,rollbar`) to send errors to Rollbar.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Optional. Used only when LOG_STACK contains `rollbar`.
ROLLBAR_TOKEN=

#--------------------------------------------------------------------------
# Database, cache, queue, and session
#--------------------------------------------------------------------------

# Production uses MySQL. The test suite and local development can use SQLite.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=byomailer
# DB_USERNAME=root
# DB_PASSWORD=
# SQLite only. The defaults let the web server, the queue worker and the
# scheduler write to one file.
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_SYNCHRONOUS=normal
# DB_TRANSACTION_MODE=IMMEDIATE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie only over https. Set it to false only for local
# development over plain http. If it is empty, the cookie is secure when the
# app URL starts with https. Browsers accept a secure cookie from localhost.
SESSION_SECURE_COOKIE=true

# The app reads the client IP from X-Forwarded-For only when the request
# comes from a trusted proxy. The default is the Cloudflare ranges. Set the
# IP addresses or CIDR ranges of your own proxy, comma-separated. Do not use
# "*" when the app port is open to the internet.
# TRUSTED_PROXIES=10.0.0.0/8

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The disk for images that users upload in the email editor (`public` or `s3`).
MEDIA_DISK=public

# Horizon needs Redis. With `redis`, the app runs Horizon. With another
# queue, the Docker image runs `queue:work`, and the app has no Horizon.
QUEUE_CONNECTION=database
# Where the send jobs keep the counters of the SES send rate: `redis` or
# `cache`. The default is `redis` only when QUEUE_CONNECTION is redis.
# SES_SENDING_LIMITER=

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=

#--------------------------------------------------------------------------
# System mail (invites, password resets, alerts)
#--------------------------------------------------------------------------
# Newsletters and sequences do not use these settings. They send through the
# AWS SES credentials that each account enters in the dashboard.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# AWS for the app itself
#--------------------------------------------------------------------------
# Used by MAIL_MAILER=ses and by the `s3` disk. Leave empty when you do not use them.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------------
# SES events (bounces, complaints, deliveries, opens, clicks)
#--------------------------------------------------------------------------
# Each account connects its own SES. BYOMailer creates an SNS topic in that
# AWS account and subscribes the topic to the SQS queue below. The
# `php artisan ses-events:poll` worker reads the queue. The Docker image runs
# the worker when these settings are set.
# The README explains the queue policy.

# AWS keys that can read and delete messages on the SQS queue.
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
PLATFORM_AWS_REGION=us-east-1
SES_EVENTS_SQS_QUEUE_URL=
SES_EVENTS_SQS_QUEUE_ARN=

#--------------------------------------------------------------------------
# Footer address (CAN-SPAM)
#--------------------------------------------------------------------------
# Each account sets its postal address in Settings, Profile. The address is
# optional. While it is empty, BYOMailer shows a warning before a send, but it
# does not block the send. No variable is necessary.

#--------------------------------------------------------------------------
# Optional integrations
#--------------------------------------------------------------------------
# Leave a value empty to turn the integration off. An empty value makes no
# network call.

# GeoIP for open locations. Get a free key at https://www.maxmind.com.
# The scheduler downloads the database only when the key is set.
MAXMIND_LICENSE_KEY=
# MAXMIND_DATABASE_PATH=storage/app/geoip/GeoLite2-City.mmdb

# Custom link domains through Cloudflare for SaaS.
# The feature needs CLOUDFLARE_API_TOKEN, CLOUDFLARE_ZONE_ID, and CLOUDFLARE_CNAME_TARGET.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# The host that the customer CNAME points at, for example link.example.com.
CLOUDFLARE_CNAME_TARGET=
# The origin server and SNI of each custom hostname. They default to the CNAME
# target. The origin certificate must cover this name, or Cloudflare returns 526.
CLOUDFLARE_ORIGIN_SERVER=
CLOUDFLARE_ORIGIN_SNI=

# Custom tracking domains through a Caddy proxy with on-demand TLS.
# The public IP of the proxy. Customers point an A record at it.
TRACKING_PROXY_IP=
# The token that Caddy sends to /tls/ask before it issues a certificate.
TRACKING_PROXY_ASK_TOKEN=

# Add each new account to a list on another BYOMailer server.
BYOMAILER_API_URL=
BYOMAILER_API_TOKEN=
BYOMAILER_LIST_ID=

# Open Graph images for the documentation pages, rendered by Snapsbrew.
SNAPSBREW_BASE_URL=https://app.snapsbrew.com
SNAPSBREW_SIGNED_URL_KEY=
SNAPSBREW_OG_TEMPLATE_ID=

# Slack notifications.
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

#--------------------------------------------------------------------------
# Outgoing webhooks
#--------------------------------------------------------------------------

WEBHOOKS_DELIVERY_RETENTION_DAYS=30
WEBHOOKS_MAX_PER_CLIENT=25
WEBHOOKS_DISABLE_AFTER_FAILURES=15
WEBHOOKS_TIMEOUT_SECONDS=10
WEBHOOKS_RESPONSE_BODY_CAP_BYTES=2048
WEBHOOKS_DELIVERY_RATE_PER_MINUTE=60

#--------------------------------------------------------------------------
# Frontend
#--------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
# Server-side rendering needs `php artisan inertia:start-ssr`. Docker Compose sets it to false.
INERTIA_SSR_ENABLED=true

#--------------------------------------------------------------------------
# Docker Compose
#--------------------------------------------------------------------------
# docker-compose.yml reads these values. It sets DB_HOST and REDIS_HOST
# itself. With no .env file, the stack runs one container with SQLite.

# The host port for the web service.
# APP_PORT=8080
# The host interface of that port. The default 127.0.0.1 takes traffic only
# from the host, for example from a reverse proxy.
# APP_BIND=127.0.0.1
# docker-compose.image.yml only: the tag of the published image.
# BYOMAILER_VERSION=latest

# The web container runs the queue worker, the scheduler and the SES events
# poller. Set a value to false when another container runs that process.
# BYOMAILER_QUEUE_WORKER=true
# BYOMAILER_SCHEDULER=true
# BYOMAILER_SES_EVENTS=true

# MySQL and Redis. Remove the "#" from these lines to use the "mysql"
# profile. Generate the password with: openssl rand -hex 24
# COMPOSE_PROFILES=mysql
# DB_CONNECTION=mysql
# DB_DATABASE=byomailer
# DB_USERNAME=byomailer
# DB_PASSWORD=
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis

#--------------------------------------------------------------------------
# Local seed data (`php artisan db:seed`)
#--------------------------------------------------------------------------
# The seeder uses these values for the demo account. All are optional.

# TEST_AWS_KEY_ID=
# TEST_AWS_KEY_SECRET=
# TEST_AWS_REGION=us-east-1
# TEST_SNS_TOPIC_ARN=
# TEST_SNS_SUBSCRIPTION_ARN=
# TEST_EMAIL_FROM=updates@example.com
# TEST_EMAIL_NAME="Updates Team"
# TEST_EMAIL_DOMAIN=
# TEST_EMAIL_FROM_SUBDOMAIN=
# TEST_EMAIL_REGION=us-east-1
# TEST_EMAIL_STATUS=verified
# TEST_EMAIL_CONFIGURATION_SET=
