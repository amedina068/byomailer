#!/command/with-contenv sh
# The queue worker. QUEUE_CONNECTION selects the worker:
#   redis       Horizon, with the supervisors of config/horizon.php
#   sync, null  no worker, because no job waits in a queue
#   other       queue:work, for example with the database queue of the image
#
# Set BYOMAILER_QUEUE_WORKER=false when another container runs the worker.
#
# The queue list holds each queue of the Horizon supervisors. The SES events
# come first, so a large newsletter does not hold back the bounces. The test
# DockerRuntimeFilesTest fails when a Horizon queue is not in the list.
cd /var/www/html || exit 1

if [ "${BYOMAILER_QUEUE_WORKER:-true}" != "true" ]; then
    exec /command/s6-pause
fi

case "${QUEUE_CONNECTION:-sync}" in
    redis)
        exec php artisan horizon
        ;;
    sync | null)
        exec /command/s6-pause
        ;;
    *)
        # --timeout is the longest timeout of the Horizon supervisors (the
        # newsletter jobs). A job that sets its own tries or timeout keeps
        # its own value.
        #
        # The worker writes no line for each job, as Horizon. The exception
        # of a failed job still goes to the log (LOG_CHANNEL=stderr). Set
        # BYOMAILER_QUEUE_VERBOSE=true to see a line for each job.
        quiet="--quiet"
        [ "${BYOMAILER_QUEUE_VERBOSE:-false}" = "true" ] && quiet=""
        # shellcheck disable=SC2086
        exec php artisan queue:work "${QUEUE_CONNECTION}" $quiet \
            --queue=ses-events,sequences,newsletter,automations,webhooks,tracking-domains,default \
            --sleep=1 --tries=3 --timeout=300 --memory=256 --max-time=3600
        ;;
esac
