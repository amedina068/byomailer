# Automatic HTTPS for the BYOMailer image. The s6 service byomailer-caddy
# starts Caddy only when APP_DOMAIN is set.
#
# The custom tracking domains of the accounts do not use this file. They use
# the proxy in deploy/tracking-proxy.
{
	admin off
	storage file_system /data/caddy
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:{$NGINX_HTTP_PORT:8080}
}
