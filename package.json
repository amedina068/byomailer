{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:changed": "git diff --name-only --diff-filter=ACMR $(git merge-base origin/main HEAD) -- 'resources/js/*.vue' 'resources/js/*.ts' 'resources/js/*.js' | xargs -r sh -c 'eslint --no-warn-ignored \"$@\" && prettier --check \"$@\"' lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ssr": "node tests/Ssr/render-smoke.mjs",
        "test:e2e": "playwright test",
        "types": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4",
        "vitest": "^4.1.6",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "@phosphor-icons/vue": "^2.2.1",
        "@tailwindcss/typography": "^0.5.19",
        "@tiptap/extension-image": "^3.35.0",
        "@tiptap/extension-link": "^3.35.0",
        "@tiptap/extension-placeholder": "^3.35.0",
        "@tiptap/extension-text-align": "^3.35.0",
        "@tiptap/extension-text-style": "^3.35.0",
        "@tiptap/extension-underline": "^3.35.0",
        "@tiptap/pm": "^3.18.0",
        "@tiptap/starter-kit": "^3.35.0",
        "@tiptap/vue-3": "^3.35.0",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "^12.8.2",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "reka-ui": "^2.11.0",
        "shiki": "^4.6.0",
        "tailwind-merge": "^3.7.1",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.46",
        "vue-input-otp": "^0.4.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.68.8",
        "@rollup/rollup-win32-x64-msvc": "4.68.8",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
